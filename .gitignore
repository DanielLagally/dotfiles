caelestia/fish/secrets.fish

# Auto-regenerated by the currently-running (pre-restart) Hyprland instance
# whenever it briefly finds hyprland.conf missing while it's still in
# .conf-mode (it doesn't pick up hyprland.lua until a full restart).
/hypr/hyprland.conf

# Upstream hyprland.lua's maybe_create() bootstrap recreates these as empty
# stubs on every load if missing — we don't use them (see the overlay
# pattern in hypr/hyprland/*.lua instead), so don't fight the regeneration.
/caelestia/hypr-user.lua
/caelestia/hypr-vars.lua
