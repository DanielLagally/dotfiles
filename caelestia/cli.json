{
    "record": {
        "extraArgs": []
    },
    "wallpaper": {
        "postHook": "echo $WALLPAPER_PATH $SCHEME_NAME $SCHEME_FLAVOUR $SCHEME_MODE $SCHEME_VARIANT $SCHEME_COLOURS"
    },
    "theme": {
        "enableTerm": true,
        "enableHypr": true,
        "enableDiscord": true,
        "enableSpicetify": true,
        "enablePandora": true,
        "enableFuzzel": true,
        "enableBtop": true,
        "enableNvtop": true,
        "enableHtop": true,
        "enableGtk": true,
        "enableQt": true,
        "enableWarp": true,
        "enableChromium": true,
        "enableZed": true,
        "enableCava": true,
        "iconTheme": "Papirus-Dark",
        "iconThemeLight": "Papirus-Light",
        "iconThemeDark": "Papirus-Dark",
        "postHook": "echo $SCHEME_NAME $SCHEME_FLAVOUR $SCHEME_MODE $SCHEME_VARIANT $SCHEME_COLOURS"
    },
    "toggles": {
        "communication": {
            "discord": {
                "enable": true,
                "match": [{ "class": "equibop" }, {"initialTitle": "Discord"} ],
                "command": ["equibop"],
                "move": true
            }
        },
        "whatsapp": {
            "whatsapp": {
                "enable": true,
                "match": [{ "class": "Altus" }],
                "command": ["altus"],
                "move": true
            }
        },
        "thunderbird": {
            "thunderbird": {
                "enable": true,
                "match": [{ "class": "thunderbird" }],
                "command": ["thunderbird"],
                "move": true
            }
        },
        "music": {
            "spotify": {
                "enable": true,
                "match": [{ "class": "Spotify" }, { "initialTitle": "Spotify" }, { "initialTitle": "Spotify Free" }],
                "command": ["spicetify", "watch", "-s"],
                "move": true
            },
            "soundcloud": {
                "enable": true,
                "match": [{ "title": "Soundcloud" }],
                "command": ["app2unit", "Soundcloud.desktop"],
                "move": true
            },
            "feishin": {
                "enable": true,
                "match": [{ "class": "feishin" }],
                "move": true
            }
        },
        "sysmon": {
            "btop": {
                "enable": true,
                "match": [{ "class": "btop", "title": "btop", "workspace": { "name": "special:sysmon" } }],
                "command": ["foot", "-a", "btop", "-T", "btop", "fish", "-C", "exec btop"]
            }
        },
        "todo": {
            "todoist": {
                "enable": true,
                "match": [{ "class": "Todoist" }],
                "command": ["todoist"],
                "move": true
            }
        },
        "grok": {
            "grok": {
                "enable": true,
                "match": [{ "class": "zen-twilight", "title": "Grok —" }],
                "command": ["app2unit", "--", "Grok.desktop"],
                "move": true
            }
        },
        "claude": {
            "claude": {
                "enable": true,
                "match": [{ "class": "zen-twilight", "title": "Claude —" }],
                "command": ["app2unit", "--", "Claude.desktop"],
                "move": true
            }
        },
        "zen": {
            "zen": {
                "enable": true,
                "match": [{ "class": "zen-twilight" }],
                "command": ["app2unit", "--", "zen-twilight"],
                "move": false
            }
        },
        "helix": {
            "helix": {
                "enable": true,
                "match": [{ "class": "helix" }],
                "command": ["foot", "-a", "helix", "-T", "helix", "fish", "-ic", "hx"],
                "move": true
            }
        },
        "yazi": {
            "yazi": {
                "enable": true,
                "match": [{ "class": "yazi" }],
                "command": ["foot", "-a", "yazi", "-T", "yazi", "fish", "-ic", "yazi"],
                "move": true
            }
        }
    },
    "dots": {
        "url": "https://github.com/caelestia-dots/caelestia.git",
        "branch": "main"
    }
}
